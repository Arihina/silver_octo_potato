# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=rag_docs

# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:2b

# Embeddings
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Chunking
CHUNK_MAX_CHARS=800
CHUNK_MIN_CHARS=200

# Retrieval
TOP_K_VECTOR=10
TOP_K_BM25=10
TOP_K_FINAL=5

# Storage (для BM25 и словаря спеллчекера)
DATA_DIR=./data
