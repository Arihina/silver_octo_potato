# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=rag_docs

# Ollama (Python client использует OLLAMA_HOST из окружения, по умолчанию localhost:11434)
OLLAMA_MODEL=gemma2:2b

# История диалога
HISTORY_LENGTH=20

# Embeddings
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Chunking
CHUNK_MAX_CHARS=800
CHUNK_MIN_CHARS=200

# Retrieval
TOP_K_VECTOR=10
TOP_K_BM25=10
TOP_K_FINAL=5

# Storage (для BM25 и словаря спеллчекера)
DATA_DIR=./data
